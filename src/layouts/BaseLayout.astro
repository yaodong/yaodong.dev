---
import BaseHead from '../components/BaseHead.astro';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  variant?: 'default' | 'about';
  ogType?: 'website' | 'article' | 'profile';
  jsonLd?: 'WebSite' | 'WebPage' | 'BlogPosting' | 'none';
  image?: string;
  publishedTime?: string;
  canonicalPath?: string;
}

const props = Astro.props;
const currentPath = Astro.url.pathname;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={SITE.lang} class="scroll-smooth">
  <head>
    <BaseHead {...props} />
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a href="/" class="logo"><span class="logo-tilde">~</span>/yaodong.dev</a>
        <nav class="site-nav" aria-label="Primary">
          {
            SITE.navigation.map((item) => (
              <a
                href={item.url}
                class:list={['nav-link', { 'nav-link-active': currentPath === item.url }]}
              >
                {item.title}
              </a>
            ))
          }
          <button
            type="button"
            class="theme-toggle"
            aria-label="Dark mode"
            aria-pressed="false"
            title="Dark mode"
          >
          <svg
            class="icon-sun"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg
            class="icon-moon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <span class="site-footer__copy">&copy; {year} {SITE.title}</span>
        <nav class="site-footer__links" aria-label="Elsewhere">
          {
            SITE.footerLinks.map((item, i) => (
              <>
                {i > 0 && <span class="site-footer__dot">&middot;</span>}
                <a href={item.url}>{item.title}</a>
              </>
            ))
          }
        </nav>
      </div>
    </footer>

    <script is:inline>
      // Theme toggle: an explicit choice is stored; otherwise follow the system.
      (function () {
        var root = document.documentElement;
        var toggle = document.querySelector('.theme-toggle');
        var STORAGE_KEY = 'theme';
        var media = window.matchMedia('(prefers-color-scheme: dark)');
        var metas = document.querySelectorAll('meta[data-theme-color]');
        var metaColors = { light: '#FBFBFA', dark: '#151514' };

        // Storage can throw (blocked cookies, sandboxed webviews); fall back to
        // the system preference instead of breaking the toggle.
        function getStoredTheme() {
          try {
            var value = localStorage.getItem(STORAGE_KEY);
            return value === 'light' || value === 'dark' ? value : null;
          } catch (e) {
            return null;
          }
        }

        function storeTheme(theme) {
          try {
            localStorage.setItem(STORAGE_KEY, theme);
          } catch (e) {}
        }

        function getCurrentTheme() {
          return getStoredTheme() || (media.matches ? 'dark' : 'light');
        }

        // Keep the browser chrome in step with a forced theme.
        function syncThemeColor(theme) {
          metas.forEach(function (meta) {
            var own = meta.getAttribute('data-theme-color');
            meta.setAttribute('content', metaColors[theme || own]);
          });
        }

        // The button's name stays "Dark mode"; aria-pressed carries the state.
        function syncToggle() {
          if (!toggle) return;
          toggle.setAttribute('aria-pressed', String(getCurrentTheme() === 'dark'));
        }

        function applyTheme(theme) {
          root.classList.remove('light', 'dark');
          if (theme) root.classList.add(theme);
          syncThemeColor(theme);
          syncToggle();
        }

        applyTheme(getStoredTheme());

        if (toggle) {
          toggle.addEventListener('click', function () {
            var next = getCurrentTheme() === 'dark' ? 'light' : 'dark';
            storeTheme(next);
            applyTheme(next);
          });
        }

        media.addEventListener('change', function () {
          if (!getStoredTheme()) applyTheme(null);
        });
      })();
    </script>

    <script is:inline>
      // Analytics loads after the page has finished loading, so it never
      // competes with the essay for bandwidth or the main thread.
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-E8XC309H1N');
      window.addEventListener('load', function () {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-E8XC309H1N';
        document.body.appendChild(s);
      });
    </script>
  </body>
</html>
