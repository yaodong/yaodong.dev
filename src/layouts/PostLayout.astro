---
import BaseLayout from './BaseLayout.astro';
import CopyPage from '../components/CopyPage.astro';
import { SITE } from '../lib/site';
import { isoDate } from '../lib/date';

interface RelatedPost {
  slug: string;
  title: string;
  created_date: Date;
}

interface Props {
  title: string;
  body: string;
  description: string;
  created_date: Date;
  updated_date?: Date;
  image?: string;
  publishedTime: string;
  canonicalPath: string;
  author?: string | { name: string; url?: string };
  related: RelatedPost[];
}

const {
  title,
  body,
  description,
  created_date,
  image,
  publishedTime,
  canonicalPath,
  author,
  related,
} = Astro.props;

// Every post is by the site author unless its front matter names someone else;
// only then does the meta line carry a byline.
let authorName: string | undefined;
let authorUrl: string | undefined;
if (author) {
  if (typeof author === 'string') {
    authorName = author;
  } else {
    authorName = author.name;
    authorUrl = author.url;
  }
  if (authorName === SITE.author.name) authorName = undefined;
}

// canonicalPath is `/<slug>/`; the Markdown twin lives at `/<slug>.md`.
const slug = canonicalPath.replace(/^\/|\/$/g, '');
const mdUrl = `${SITE.url}/${slug}.md`;
const pageUrl = `${SITE.url}${canonicalPath}`;

// Rough reading time from the Markdown source: drop code, HTML tags and link
// targets, then count words at ~230 wpm.
const words = body
  .replace(/```[\s\S]*?```/g, ' ')
  .replace(/<[^>]+>/g, ' ')
  .replace(/\]\([^)]*\)/g, ']')
  .split(/\s+/)
  .filter((w) => /\w/.test(w)).length;
const readingMinutes = Math.max(1, Math.round(words / 230));
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  jsonLd="BlogPosting"
  image={image}
  publishedTime={publishedTime}
  canonicalPath={canonicalPath}
>
  <main id="main-content" tabindex="-1" class="page-main page-main--post">
    <article>
      <header class="post-header">
        <div class="post-top">
          <a href="/" class="back-link" data-back-link>← back</a>
        </div>

        <h1 class="post-title">{title}</h1>

        <div class="post-byline">
          <div class="post-meta">
            <time datetime={isoDate(created_date)}>{isoDate(created_date)}</time>
            {
              authorName && (
                <>
                  <span class="post-meta__dot" aria-hidden="true">&middot;</span>
                  <span>
                    by{' '}
                    {authorUrl ? (
                      <a href={authorUrl} rel="author">{authorName}</a>
                    ) : (
                      <span>{authorName}</span>
                    )}
                  </span>
                </>
              )
            }
            <span class="post-meta__dot" aria-hidden="true">&middot;</span>
            <span>{readingMinutes} min read</span>
          </div>
          <CopyPage title={title} mdUrl={mdUrl} pageUrl={pageUrl} />
        </div>
      </header>

      <div class="prose max-w-none">
        <slot />
      </div>
    </article>

    <aside class="signoff" aria-label="About the author">
      <p class="signoff__text">
        I'm <a href="/about/">Yaodong Zhao</a>, a software engineer. I build web
        applications, though these days I mostly supervise something else
        building them.
      </p>
    </aside>

    {
      related.length > 0 && (
        <section class="related">
          <h2 class="related__label">More writing</h2>
          <div class="related__list">
            {related.map((rp) => (
              <div class="related__row">
                <h3 class="related__heading">
                  <a href={`/${rp.slug}/`} class="related__title">
                    {rp.title}
                  </a>
                </h3>
                <time class="related__date" datetime={isoDate(rp.created_date)}>
                  {isoDate(rp.created_date)}
                </time>
              </div>
            ))}
          </div>
        </section>
      )
    }
  </main>

  <script is:inline>
    // "← back" returns to wherever the reader came from on this site (home,
    // archive, another post), with its scroll position; a direct visit or a
    // new tab falls back to the home page. Jumping to an anchor on this page
    // (skip link, footnotes) adds history entries, so after one the link just
    // follows its href instead of stepping back through them.
    (function () {
      var link = document.querySelector('[data-back-link]');
      if (!link || !document.referrer) return;
      var from;
      try {
        from = new URL(document.referrer);
      } catch (e) {
        return;
      }
      if (from.origin !== location.origin || from.pathname === location.pathname) return;
      link.href = from.pathname + from.search;
      var jumped = false;
      window.addEventListener('hashchange', function () {
        jumped = true;
      });
      link.addEventListener('click', function (event) {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        if (!jumped && history.length > 1) {
          event.preventDefault();
          history.back();
        }
      });
    })();
  </script>
</BaseLayout>
