---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isoDate } from '../lib/date';
import { postSlug } from '../lib/site';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.created_date.valueOf() - a.data.created_date.valueOf()
);
const featured = posts[0];
const rest = posts.slice(1, 10);

const description =
  'Technical articles on Ruby, Rails, AI coding tools, and software engineering by Yaodong Zhao.';
---

<BaseLayout
  title="Yaodong Zhao"
  description={description}
  jsonLd="WebSite"
  ogType="website"
>
  <h1 class="sr-only">Writing by Yaodong Zhao</h1>
  {
    featured && (
      <div class="featured">
        <div class="container featured__inner">
          <div class="featured__label">LATEST · {isoDate(featured.data.created_date)}</div>
          <h2 class="featured__heading">
            <a href={`/${postSlug(featured.id)}/`} class="featured__title">
              {featured.data.title}
            </a>
          </h2>
          {featured.data.excerpt && (
            <p class="featured__excerpt">{featured.data.excerpt}</p>
          )}
          <a href={`/${postSlug(featured.id)}/`} class="arrow-link" style="margin-top: 18px;">
            read →
          </a>
        </div>
      </div>
    )
  }

  <main id="main-content" tabindex="-1" class="page-main page-main--home">
    {
      rest.length > 0 ? (
        <div class="post-list">
          {rest.map((post) => (
            <article class="post-row">
              <div class="post-row__head">
                <h2 class="post-row__heading">
                  <a href={`/${postSlug(post.id)}/`} class="post-row__title">
                    {post.data.title}
                  </a>
                </h2>
                <time class="post-row__date" datetime={isoDate(post.data.created_date)}>
                  {isoDate(post.data.created_date)}
                </time>
              </div>
              {post.data.excerpt && (
                <p class="post-row__excerpt">{post.data.excerpt}</p>
              )}
            </article>
          ))}
        </div>
      ) : (
        <p class="post-row__excerpt">No posts found.</p>
      )
    }
    {
      rest.length > 0 && (
        <a href="/archive/" class="arrow-link" style="margin-top: 24px;">
          all posts →
        </a>
      )
    }
  </main>
</BaseLayout>
