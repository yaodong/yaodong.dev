---
import BaseLayout from '../layouts/BaseLayout.astro';

const description =
  'The page you’re looking for doesn’t exist. Return to yaodong.dev to explore technical articles on Ruby, Rails, and software engineering.';
---

<BaseLayout
  title="Page Not Found"
  description={description}
  jsonLd="WebPage"
  ogType="website"
  canonicalPath="/404.html"
>
  <main id="main-content" tabindex="-1" class="page-main page-main--notfound">
    <h1 class="sr-only">Page not found</h1>
    <p class="notfound__status">HTTP/1.1 404 — not found</p>
    <p class="notfound__code" aria-hidden="true">404</p>
    <p class="notfound__text">
      This page doesn’t exist or has moved. The link that brought you here may
      be out of date.
    </p>
    <div class="notfound__actions">
      <a href="/" class="arrow-link">back home →</a>
      <a href="/archive/" class="arrow-link">browse the archive →</a>
    </div>
  </main>
</BaseLayout>
