---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isoDate, monthDay } from '../lib/date';
import { postSlug } from '../lib/site';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.created_date.valueOf() - a.data.created_date.valueOf()
);

// Group by year (UTC), preserving the descending order of the sorted list.
const byYear: { year: string; items: CollectionEntry<'blog'>[] }[] = [];
for (const post of posts) {
  const year = String(post.data.created_date.getUTCFullYear());
  let group = byYear.find((g) => g.year === year);
  if (!group) {
    group = { year, items: [] };
    byYear.push(group);
  }
  group.items.push(post);
}

const description =
  'Complete archive of all blog posts by Yaodong Zhao, organized by year.';
---

<BaseLayout
  title="Archive"
  description={description}
  jsonLd="WebPage"
  ogType="website"
>
  <main id="main-content" tabindex="-1" class="page-main page-main--archive">
    <h1 class="page-title">Archive</h1>

    {
      posts.length > 0 ? (
        byYear.map((group) => (
          <div class="archive-group">
            <h2 class="archive-year">{group.year}</h2>
            <div class="archive-list">
              {group.items.map((post) => (
                <div class="archive-row">
                  <h3 class="archive-row__heading">
                    <a href={`/${postSlug(post.id)}/`} class="archive-row__title">
                      {post.data.title}
                    </a>
                  </h3>
                  <time class="archive-row__date" datetime={isoDate(post.data.created_date)}>
                    {monthDay(post.data.created_date)}
                  </time>
                </div>
              ))}
            </div>
          </div>
        ))
      ) : (
        <p class="post-row__excerpt">No posts published yet.</p>
      )
    }
  </main>
</BaseLayout>
