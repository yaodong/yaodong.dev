---
interface Props {
  title: string;
  body: string;
  mdUrl: string; // absolute, e.g. https://yaodong.dev/<slug>.md
  pageUrl: string; // absolute canonical URL, e.g. https://yaodong.dev/<slug>/
}

const { title, body, mdUrl, pageUrl } = Astro.props;

// The clipboard content and the /<slug>.md file content are identical.
const markdown = `# ${title}\n\n${body}`;
const mdLink = `[${title}](${pageUrl})`;

const prompt = `Read from ${mdUrl} so I can ask questions about it.`;
const claudeUrl = `https://claude.ai/new?q=${encodeURIComponent(prompt)}`;
const chatgptUrl = `https://chatgpt.com/?q=${encodeURIComponent(prompt)}`;
---

<div class="copy-page" data-copy-page>
  <div class="copy-page__split">
    <button
      type="button"
      class="copy-page__main"
      data-copy-action="markdown"
      aria-label="Copy page as Markdown"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <span class="copy-page__label" data-copy-label>Copy page</span>
    </button>
    <button
      type="button"
      class="copy-page__caret"
      data-copy-toggle
      aria-haspopup="true"
      aria-controls="copy-page-menu"
      aria-expanded="false"
      aria-label="Open copy options"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M6 9l6 6 6-6"></path>
      </svg>
    </button>
  </div>

  <ul class="copy-page__menu" data-copy-menu id="copy-page-menu" hidden>
    <li>
      <button type="button" class="copy-page__item" data-copy-action="markdown">
        Copy page
      </button>
    </li>
    <li>
      <button type="button" class="copy-page__item" data-copy-action="link">
        Copy link
      </button>
    </li>
    <li>
      <button type="button" class="copy-page__item" data-copy-action="mdlink">
        Copy Markdown link
      </button>
    </li>
    <li>
      <a class="copy-page__item" href={mdUrl}>View as Markdown</a>
    </li>
    <li>
      <a class="copy-page__item" href={claudeUrl} target="_blank" rel="noopener">
        Open in Claude
      </a>
    </li>
    <li>
      <a class="copy-page__item" href={chatgptUrl} target="_blank" rel="noopener">
        Open in ChatGPT
      </a>
    </li>
  </ul>

  <!-- Inline copy sources for an instant, network-free clipboard write, keyed
       by the data-copy-action value that should copy each one. Astro escapes
       these text expressions, so textContent decodes back to the exact text
       even if the body contains </script> or & or <. -->
  <div class="copy-page__source" data-copy-value="markdown" hidden>{markdown}</div>
  <div class="copy-page__source" data-copy-value="link" hidden>{pageUrl}</div>
  <div class="copy-page__source" data-copy-value="mdlink" hidden>{mdLink}</div>
</div>

<script>
  const root = document.querySelector('[data-copy-page]');
  if (root) {
    const toggle = root.querySelector<HTMLElement>('[data-copy-toggle]');
    const menu = root.querySelector<HTMLElement>('[data-copy-menu]');
    const label = root.querySelector<HTMLElement>('[data-copy-label]');
    const actions = root.querySelectorAll<HTMLElement>('[data-copy-action]');
    const defaultLabel = label ? label.textContent : 'Copy page';
    let resetTimer: ReturnType<typeof setTimeout>;

    function openMenu() {
      if (!menu || !toggle) return;
      menu.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
    }

    function closeMenu() {
      if (!menu || !toggle) return;
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
    }

    function isOpen() {
      return menu ? !menu.hidden : false;
    }

    const copy = async (kind: string) => {
      const source = root.querySelector<HTMLElement>(`[data-copy-value="${kind}"]`);
      const text = source ? source.textContent || '' : '';
      try {
        if (!navigator.clipboard) throw new Error('no clipboard');
        await navigator.clipboard.writeText(text);
        if (label) {
          label.textContent = 'Copied!';
          clearTimeout(resetTimer);
          resetTimer = setTimeout(() => {
            label.textContent = defaultLabel;
          }, 1500);
        }
      } catch {
        // Fail gracefully: the raw Markdown stays reachable via "View as Markdown".
      }
      closeMenu();
    };

    toggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      isOpen() ? closeMenu() : openMenu();
    });

    actions.forEach((btn) =>
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        copy(btn.dataset.copyAction || 'markdown');
      })
    );

    // Selecting a link item closes the menu (links navigate on their own).
    menu?.querySelectorAll('a.copy-page__item').forEach((link) =>
      link.addEventListener('click', () => closeMenu())
    );

    document.addEventListener('click', (e) => {
      if (isOpen() && !root.contains(e.target as Node)) closeMenu();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        closeMenu();
        toggle?.focus();
      }
    });
  }
</script>
