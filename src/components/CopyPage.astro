---
interface Props {
  title: string;
  mdUrl: string; // absolute, e.g. https://yaodong.dev/<slug>.md
  pageUrl: string; // absolute canonical URL, e.g. https://yaodong.dev/<slug>/
}

const { title, mdUrl, pageUrl } = Astro.props;

// "Copy page" copies the /<slug>.md file itself, fetched from this origin so it
// also works on the dev server and previews.
const mdPath = new URL(mdUrl).pathname;
const mdLink = `[${title}](${pageUrl})`;

const prompt = `Read from ${mdUrl} so I can ask questions about it.`;
const claudeUrl = `https://claude.ai/new?q=${encodeURIComponent(prompt)}`;
const chatgptUrl = `https://chatgpt.com/?q=${encodeURIComponent(prompt)}`;
---

<div class="copy-page" data-copy-page data-md-path={mdPath}>
  <div class="copy-page__split">
    <button
      type="button"
      class="copy-page__main"
      data-copy-action="markdown"
      title="Copy this page as Markdown"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <span class="copy-page__label" data-copy-label>Copy page</span>
    </button>
    <button
      type="button"
      class="copy-page__caret"
      data-copy-toggle
      aria-controls="copy-page-menu"
      aria-expanded="false"
      aria-label="More copy options"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M6 9l6 6 6-6"></path>
      </svg>
    </button>
  </div>

  <ul class="copy-page__menu" data-copy-menu id="copy-page-menu" hidden>
    <li>
      <button type="button" class="copy-page__item" data-copy-action="link">
        Copy link
      </button>
    </li>
    <li>
      <button type="button" class="copy-page__item" data-copy-action="mdlink">
        Copy Markdown link
      </button>
    </li>
    <li>
      <a class="copy-page__item" href={mdUrl}>View as Markdown</a>
    </li>
    <li>
      <a class="copy-page__item" href={claudeUrl} target="_blank" rel="noopener">
        Open in Claude
        <svg
          class="copy-page__ext"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7 17L17 7M8 7h9v9"></path>
        </svg>
        <span class="sr-only">(opens in a new tab)</span>
      </a>
    </li>
    <li>
      <a class="copy-page__item" href={chatgptUrl} target="_blank" rel="noopener">
        Open in ChatGPT
        <svg
          class="copy-page__ext"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7 17L17 7M8 7h9v9"></path>
        </svg>
        <span class="sr-only">(opens in a new tab)</span>
      </a>
    </li>
  </ul>

  <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>

  <!-- Inline copy sources for the two short values, keyed by the
       data-copy-action value that copies each one. The page's Markdown isn't
       inlined: it would double the size of every post for a rarely used button. -->
  <div class="copy-page__source" data-copy-value="link" hidden>{pageUrl}</div>
  <div class="copy-page__source" data-copy-value="mdlink" hidden>{mdLink}</div>
</div>

<script>
  const root = document.querySelector('[data-copy-page]');
  if (root) {
    const toggle = root.querySelector<HTMLElement>('[data-copy-toggle]');
    const menu = root.querySelector<HTMLElement>('[data-copy-menu]');
    const label = root.querySelector<HTMLElement>('[data-copy-label]');
    const status = root.querySelector<HTMLElement>('[data-copy-status]');
    const actions = root.querySelectorAll<HTMLElement>('[data-copy-action]');
    const defaultLabel = label ? label.textContent : 'Copy page';
    let resetTimer: ReturnType<typeof setTimeout>;
    let markdownRequest: Promise<string> | undefined;

    // One request per page view, started as soon as the reader heads for the
    // button so the copy is usually instant.
    function fetchMarkdown() {
      markdownRequest ||= fetch(root!.getAttribute('data-md-path') || '').then((r) => {
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        return r.text();
      });
      markdownRequest.catch(() => (markdownRequest = undefined));
      return markdownRequest;
    }

    // Safari only allows a clipboard write that starts inside the click, so the
    // write begins now and receives the text when the request finishes. Browsers
    // without promise-valued ClipboardItems write the text once it arrives.
    async function writeMarkdown() {
      if (typeof ClipboardItem !== 'undefined' && navigator.clipboard.write) {
        const blob = fetchMarkdown().then((text) => new Blob([text], { type: 'text/plain' }));
        // Handled below; this only keeps a failed request out of the console.
        blob.catch(() => {});
        try {
          await navigator.clipboard.write([new ClipboardItem({ 'text/plain': blob })]);
          return;
        } catch {
          // A failed request can't be fixed by trying another way.
          await blob;
        }
      }
      await navigator.clipboard.writeText(await fetchMarkdown());
    }

    function openMenu() {
      if (!menu || !toggle) return;
      menu.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
    }

    function closeMenu() {
      if (!menu || !toggle) return;
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
    }

    function isOpen() {
      return menu ? !menu.hidden : false;
    }

    const announcements: Record<string, string> = {
      markdown: 'Page copied as Markdown',
      link: 'Link copied',
      mdlink: 'Markdown link copied',
    };

    // Show the result on the button and say it to screen readers, then reset.
    function report(visible: string, spoken: string) {
      if (label) label.textContent = visible;
      if (status) status.textContent = spoken;
      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        if (label) label.textContent = defaultLabel;
        if (status) status.textContent = '';
      }, 2000);
    }

    const copy = async (kind: string, fromMenu: boolean) => {
      const source = root.querySelector<HTMLElement>(`[data-copy-value="${kind}"]`);
      const text = source ? source.textContent || '' : '';
      try {
        if (!navigator.clipboard) throw new Error('no clipboard');
        if (kind === 'markdown') await writeMarkdown();
        else await navigator.clipboard.writeText(text);
        report('Copied!', announcements[kind] || 'Copied');
      } catch {
        // The raw Markdown stays reachable via "View as Markdown" in the menu.
        report('Copy failed', 'Copy failed. Use View as Markdown in the copy options instead.');
      }
      closeMenu();
      // The item that had focus is now hidden; hand focus back to the toggle.
      if (fromMenu) toggle?.focus();
    };

    const main = root.querySelector('[data-copy-action="markdown"]');
    ['pointerenter', 'focus', 'touchstart'].forEach((type) =>
      main?.addEventListener(type, () => fetchMarkdown().catch(() => {}), { once: true, passive: true })
    );

    toggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      isOpen() ? closeMenu() : openMenu();
    });

    actions.forEach((btn) =>
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        copy(btn.dataset.copyAction || 'markdown', !!menu?.contains(btn));
      })
    );

    // Selecting a link item closes the menu (links navigate on their own).
    menu?.querySelectorAll('a.copy-page__item').forEach((link) =>
      link.addEventListener('click', () => closeMenu())
    );

    // Close when keyboard focus leaves the control entirely.
    root.addEventListener('focusout', (e) => {
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (isOpen() && next && !root.contains(next)) closeMenu();
    });

    document.addEventListener('click', (e) => {
      if (isOpen() && !root.contains(e.target as Node)) closeMenu();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        closeMenu();
        toggle?.focus();
      }
    });
  }
</script>
